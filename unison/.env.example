# Copy to .env (git-ignored). Expo inlines EXPO_PUBLIC_* variables into the JS bundle.

# --- ACRCloud (console.acrcloud.com -> Audio & Video Recognition project) ---
# Host is region-specific, e.g. identify-eu-west-1.acrcloud.com / identify-us-west-2.acrcloud.com / identify-ap-southeast-1.acrcloud.com
EXPO_PUBLIC_ACR_HOST=identify-eu-west-1.acrcloud.com
EXPO_PUBLIC_ACR_ACCESS_KEY=

# DEVELOPMENT ONLY. Anything in the JS bundle can be extracted from a shipped app.
# For production leave this empty and run the signing proxy (server/acr-sign-proxy.mjs).
EXPO_PUBLIC_ACR_ACCESS_SECRET=

# Production: URL of the signing proxy, e.g. https://unison-proxy.example.com/sign
EXPO_PUBLIC_ACR_SIGN_PROXY_URL=

# --- Spotify (developer.spotify.com/dashboard) ---
# Add the redirect URI "unison://spotify-auth" (native) and your https origin (web) in the Spotify dashboard.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
