{
  "expo": {
    "name": "Unison",
    "slug": "unison",
    "version": "0.1.0",
    "scheme": "unison",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.example.unison",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Unison listens for a few seconds to identify the song playing around you and syncs your Spotify to it."
      }
    },
    "android": {
      "package": "com.example.unison",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Unison listens for a few seconds to identify the song playing around you and syncs your Spotify to it."
        }
      ],
      "expo-secure-store"
    ]
  }
}
